# Everything here is optional for local use.
PORT=8787

# Live AI coaching, answer scoring and resume rewriting
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-astra

# Required (12+ characters) before hosting anywhere other than your own computer
APP_PASSWORD=

# MongoDB backup, for example a MongoDB Atlas connection string
MONGODB_URI=
MONGODB_DATABASE=switchboard

# Your Jitsi deployment, for live video rooms
JITSI_DOMAIN=
